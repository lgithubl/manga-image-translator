FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    CUSTOM_OPENAI_API_BASE=http://127.0.0.1:8000/v1 \
    CUSTOM_OPENAI_API_KEY=codex-oauth \
    CUSTOM_OPENAI_MODEL=auto \
    CODEX_AUTH_FILE=/root/.codex/auth.json

WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN apt-get update --yes \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ffmpeg \
        git \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsm6 \
        libxext6 \
        pkg-config \
    && python -m pip install --upgrade pip setuptools wheel \
    && grep -v -E '^(torch|torchvision|bitsandbytes)([[:space:]]|$)' /app/requirements.txt > /tmp/requirements-cpu.txt \
    && pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r /tmp/requirements-cpu.txt \
    && apt-get purge --yes build-essential git pkg-config \
    && apt-get autoremove --yes \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements-cpu.txt /root/.cache/pip

COPY . /app

ENTRYPOINT ["python", "-m", "manga_translator"]
CMD ["--help"]
